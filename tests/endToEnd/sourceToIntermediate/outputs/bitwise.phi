function Bitwise~testNot (Native): Native
{
    introduce Native v#0
    take v#0 p#0
    introduce Native v#1
    move v#1 v#0
    not v#1
    give r#0 v#1
    return
}

function Bitwise~testAnd (Native, Native): Native
{
    introduce Native v#2
    take v#2 p#0
    introduce Native v#3
    take v#3 p#1
    introduce Native v#4
    move v#4 v#2
    introduce Native v#5
    move v#5 v#3
    and v#4 v#5
    give r#0 v#4
    return
}

function Bitwise~testOr (Native, Native): Native
{
    introduce Native v#6
    take v#6 p#0
    introduce Native v#7
    take v#7 p#1
    introduce Native v#8
    move v#8 v#6
    introduce Native v#9
    move v#9 v#7
    or v#8 v#9
    give r#0 v#8
    return
}

function main (): Void
{
    introduce Native v#10
    move v#10 Native(2)
    give p#0 v#10
    call Bitwise~testNot
    introduce Native v#11
    move v#11 Native(2)
    give p#0 v#11
    introduce Native v#12
    move v#12 Native(3)
    give p#1 v#12
    call Bitwise~testAnd
    introduce Native v#13
    move v#13 Native(2)
    give p#0 v#13
    introduce Native v#14
    move v#14 Native(3)
    give p#1 v#14
    call Bitwise~testOr
    return
}
