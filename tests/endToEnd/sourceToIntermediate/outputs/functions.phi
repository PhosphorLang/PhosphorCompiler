function Functions~add (Native, Native): Native
{
    introduce Native v#0
    take v#0 p#0
    introduce Native v#1
    take v#1 p#1
    introduce Native v#2
    move v#2 v#0
    introduce Native v#3
    move v#3 v#1
    add v#2 v#3
    introduce Native v#4
    move v#4 v#2
    give r#0 v#4
    return
}

function Functions~testAdd (): Native
{
    introduce Native v#6
    move v#6 Native(1)
    give p#0 v#6
    introduce Native v#7
    move v#7 Native(2)
    give p#1 v#7
    call Functions~add
    introduce Native v#5
    take v#5 r#0
    introduce Native v#8
    move v#8 v#5
    give r#0 v#8
    return
}

function main (): Void
{
    call Functions~testAdd
    return
}
