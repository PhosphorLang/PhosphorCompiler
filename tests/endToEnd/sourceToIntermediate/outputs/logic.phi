function main (): Void
{
    introduce Int8 v#30
    move v#30 Int8(-1)
    give p#0 v#30
    call Logic~testNot
    introduce Int8 v#31
    move v#31 Int8(-1)
    give p#0 v#31
    introduce Int8 v#32
    move v#32 Int8(0)
