external Standard.String~stringsAreEqual (Pointer, Pointer): Int8

constant Strings~c#0 "abc"
constant Strings~c#1 "def"

function Strings~testStringCompare (Pointer, Pointer): Int8
{
    introduce Pointer v#0
    take v#0 p#0
    introduce Pointer v#1
    take v#1 p#1
    introduce Pointer v#3
    move v#3 v#0
    give p#0 v#3
    introduce Pointer v#4
    move v#4 v#1
    give p#1 v#4
    call Standard.String~stringsAreEqual
    introduce Int8 v#2
    take v#2 r#0
    give r#0 v#2
    return
}

function main (): Void
{
    introduce Pointer v#5
    move v#5 Strings~c#0
    give p#0 v#5
    introduce Pointer v#6
    move v#6 Strings~c#1
    give p#1 v#6
    call Strings~testStringCompare
    introduce Pointer v#7
    move v#7 Strings~c#0
    give p#0 v#7
    introduce Pointer v#8
    move v#8 Strings~c#0
    give p#1 v#8
    call Strings~testStringCompare
    return
}
