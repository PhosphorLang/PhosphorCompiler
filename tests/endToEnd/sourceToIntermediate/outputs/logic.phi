    introduce Native v#14
    move v#14 v#11
    compare v#13 v#14
    jumpIfEqual l#0
    introduce Int8 v#12
    move v#12 Int8(0)
    goto l#1
    l#0:
    move v#12 Int8(-1)
    l#1:
    give r#0 v#12
